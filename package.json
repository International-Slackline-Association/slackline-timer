{
  "name": "slackline-timer",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time race timer, live results and automatic rankings for slackline speed and freestyle competitions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/International-Slackline-Association/slackline-timer.git"
  },
  "bugs": {
    "url": "https://github.com/International-Slackline-Association/slackline-timer/issues"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "prettify": "prettier --write '**/*.{js,ts,tsx}'",
    "format:check": "prettier --check '**/*.{js,ts,tsx,json,md,yml,yaml}'",
    "lint": "eslint .",
    "typecheck": "npm --prefix web run checkTs && npm --prefix server run checkTs",
    "test": "npm --prefix web test && npm --prefix server test",
    "synth": "npm --prefix server run synth",
    "dev:check": "node scripts/check-env.js",
    "dev:web": "npm --prefix web start",
    "dev": "node scripts/check-env.js && npm run db:up && concurrently --names \"api,web\" --prefix-colors \"magenta,green\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev:api",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml stop",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "node server/scripts/seedLocal.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint-react/eslint-plugin": "5.18.1",
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.66.0"
  },
  "author": {
    "name": "Can Sahin"
  },
  "license": "GPL-3.0-or-later"
}
