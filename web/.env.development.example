# Local development config for the web app.
#
# Copy this file to `.env.development` (already git-ignored) — Vite loads it
# automatically when you run `npm start` / `vite dev`.

# Point the WebSocket client at the local WS relay harness (npm run dev /
# dev:api) instead of the prod backend. Use 127.0.0.1, not localhost: the
# harness binds IPv4 and the browser resolves localhost to ::1 on some setups.
VITE_APP_WS_URL=ws://127.0.0.1:3001

# Bypass Cognito sign-in + operator-group checks so you can run the UI offline.
# Leave unset (or "false") to use the real Cognito auth flow.
VITE_APP_LOCAL_DEV=true

# Competition-data HTTP API — the local HTTP harness on :3002, so the /admin/*
# pages and /stream/* overlays (and the Speedline race recorder) work against
# the LocalStack DynamoDB + S3.
VITE_APP_API_URL=http://127.0.0.1:3002
