# Deployment configuration for slackline-timer.
#
# Copy this file to `.env.deploy` (git-ignored) and fill in your own values.
# Nothing here is a secret, but it is operator- and account-specific, so it is
# never committed (ADR 0048).
#
# Loaded automatically by every piece of deploy/ops tooling: `server/infra/app.ts`
# (the CDK entrypoint), `web/internals/deployToS3.mjs` (the frontend deploy),
# `server/scripts/lib/awsCli.mjs` (commission / decommission / maintenance) and
# `server/scripts/cognito/cognitoCommon.mjs` (the Cognito helpers). An
# already-exported variable still wins. Real secrets live in SSM SecureString
# parameters and are fetched at runtime — never here.

# The AWS CLI profile used for `cdk deploy` and the S3/CloudFront sync.
AWS_PROFILE=<your-profile>

# The AWS account the stacks live in. `server/infra/app.ts` fails the synth when
# the credentials above resolve to another account (wrong-profile guard); it
# also names the `cdk gc` environment (server/scripts/maintenance/
# gcBootstrapAssets.mjs) and the Cognito helpers' wrong-account diagnosis.
AWS_ACCOUNT_ID=<account-id>

# The address subscribed to the cost backstop (ADR 0031 §1): the monthly AWS
# Budget's 50/80/100% notifications and the us-east-1 EstimatedCharges alarm —
# and to the backend's eu-central-2 ops alarms (deploy.md §6.5).
# REQUIRED to synth/deploy (no default: a dead address would silence the
# alerts). Prefer a distribution list over an individual mailbox.
BILLING_ALERT_EMAIL=<billing-alert-email>

# --- Cognito (the shared ISA pool) -------------------------------------------
#
# Deploy *inputs*: the pool is externally owned, so no stack can output it. Not
# secret, but committed they would point a fork at someone else's users
# (ADR 0048).
#
# Read by the CDK entrypoint (`server/infra/app.ts`, where `-c key=value`
# context wins over the env), the web build (re-exported as the matching
# `VITE_APP_COGNITO_*` vars by the deploy tooling) and the helpers in
# `server/scripts/cognito/` (where `--pool-id` / `--client-id` / `--region` /
# `--group` win per run).

# The pool does not move with the backend, so its region is configured
# separately from the stack's own; the managers Lambda pins its client to it.
COGNITO_USER_POOL_ID=<pool-id>
COGNITO_REGION=<pool-region>

# The timer's public SPA app client (no secret, auth-code flow) — must be the
# client whose callback/sign-out URLs list this deployment's web origin.
COGNITO_CLIENT_ID=<app-client-id>

# Hosted-UI domain for the sign-in redirect. Web build only: the Lambdas verify
# tokens against the pool and never see it.
COGNITO_DOMAIN=<hosted-ui-domain>

# The superadmin group (ADR 0045; any other ISA login is a comp-scoped manager).
# The web app and the authorizers both check it: one string on both sides.
COGNITO_TIMER_GROUP=<operator-group>
